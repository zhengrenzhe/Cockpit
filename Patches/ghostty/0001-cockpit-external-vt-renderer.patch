+test "cockpit bridge retains the maximal scrollback suffix across relocation" {
+    const old = [_]HistoryRow{
+        .{ .identity = .{ .node = 1, .serial = 1, .row = 0 }, .absolute_index = 10, .text = @constCast("discarded"), .wrapped = false },
+        .{ .identity = .{ .node = 1, .serial = 1, .row = 1 }, .absolute_index = 11, .text = @constCast("repeat"), .wrapped = true },
+        .{ .identity = .{ .node = 1, .serial = 1, .row = 2 }, .absolute_index = 12, .text = @constCast("repeat"), .wrapped = true },
+    };
+    const retained = [_]HistoryRow{
+        .{ .identity = .{ .node = 1, .serial = 1, .row = 1 }, .absolute_index = 0, .text = @constCast("repeat"), .wrapped = true },
+        .{ .identity = .{ .node = 1, .serial = 1, .row = 2 }, .absolute_index = 0, .text = @constCast("repeat"), .wrapped = true },
+        .{ .identity = .{ .node = 1, .serial = 1, .row = 3 }, .absolute_index = 0, .text = @constCast("new"), .wrapped = false },
+    };
+    try std.testing.expectEqual(@as(usize, 2), try historyIdentityOverlap(&old, &retained));
+
+    const relocated = [_]HistoryRow{
+        .{ .identity = .{ .node = 2, .serial = 2, .row = 0 }, .absolute_index = 0, .text = @constCast("repeat"), .wrapped = true },
+        .{ .identity = .{ .node = 2, .serial = 2, .row = 1 }, .absolute_index = 0, .text = @constCast("repeat"), .wrapped = true },
+        .{ .identity = .{ .node = 2, .serial = 2, .row = 2 }, .absolute_index = 0, .text = @constCast("new"), .wrapped = false },
+    };
+    try std.testing.expectEqual(@as(usize, 0), try historyIdentityOverlap(&old, &relocated));
+}
