@@ -0,0 +1,1018 @@
+const std = @import("std");
+const ghostty = @import("ghostty-vt");
+
+const alloc = std.heap.c_allocator;
+const maximum_frame_length: usize = 16 * 1024 * 1024;
+
+const Bytes = extern struct {
+    bytes: ?[*]const u8,
+    length: usize,
+};
+
+const KeyEvent = extern struct {
+    logical_key: u32,
+    physical_key: u32,
+    modifiers: u32,
+    action: u8,
+    reserved: [3]u8,
+};
+
+const MouseEvent = extern struct {
+    cell_x: i32,
+    cell_y: i32,
+    buttons: u32,
+    wheel_x: i32,
+    wheel_y: i32,
+    modifiers: u32,
+    action: u8,
+    reserved: [3]u8,
+};
+
+const HistoryIdentity = struct {
+    node: usize,
+    serial: u64,
+    row: u32,
+};
+
+const HistoryRow = struct {
+    identity: HistoryIdentity,
+    absolute_index: u64,
+    text: []u8,
+    wrapped: bool,
+};
+
+const HistoryCache = struct {
+    rows: std.ArrayList(HistoryRow) = .empty,
+    screen_generation: usize = 0,
+    page_serial_epoch: u64 = 0,
+};
+
+const HistoryAnchor = struct {
+    pin: *ghostty.Pin,
+    absolute_index: u64,
+};
+
+const HistoryRelocations = std.AutoHashMap(HistoryIdentity, u64);
+
+const Bridge = struct {
+    io: std.Io.Threaded,
+    terminal: ghostty.Terminal,
+    stream: ghostty.TerminalStream,
+    render_state: ghostty.RenderState,
+    columns: u32,
+    rows: u32,
+    sequence: u64,
+    primary_history: HistoryCache,
+    alternate_history: HistoryCache,
+    next_history_index: u64,
+    previous_buttons: u32,
+    wheel_x_remainder: i64,
+    wheel_y_remainder: i64,
+};
+
+const Buffer = struct {
+    bytes: std.ArrayList(u8) = .empty,
+
+    fn deinit(self: *Buffer) void {
+        self.bytes.deinit(alloc);
+    }
+
+    fn append(self: *Buffer, data: []const u8) !void {
+        try self.bytes.appendSlice(alloc, data);
+    }
+
+    fn byte(self: *Buffer, value: u8) !void {
+        try self.bytes.append(alloc, value);
+    }
+
+    fn int(self: *Buffer, comptime T: type, value: T) !void {
+        var encoded: [@sizeOf(T)]u8 = undefined;
+        std.mem.writeInt(T, &encoded, value, .big);
+        try self.append(&encoded);
+    }
+
+    fn take(self: *Buffer) ![]u8 {
+        return self.bytes.toOwnedSlice(alloc);
+    }
+};
+
+const Section = struct {
+    kind: u8,
+    payload: Buffer,
+
+    fn deinit(self: *Section) void {
+        self.payload.deinit();
+    }
+};
+
+const CellRef = struct {
+    row: u32,
+    column: u32,
+    width: u8,
+    grapheme: u32,
+    style: u32,
+};
+
+fn empty(out: ?*Bytes) void {
+    if (out) |value| value.* = .{ .bytes = null, .length = 0 };
+}
+
+fn returnBytes(out: *Bytes, owned: []u8) c_int {
+    if (owned.len == 0) {
+        alloc.free(owned);
+        out.* = .{ .bytes = null, .length = 0 };
+        return 0;
+    }
+    if (owned.len > maximum_frame_length) {
+        alloc.free(owned);
+        return -1;
+    }
+    out.* = .{ .bytes = owned.ptr, .length = owned.len };
+    return 0;
+}
+
+fn validDimensions(columns: u32, rows: u32) bool {
+    return columns > 0 and rows > 0 and
+        columns <= std.math.maxInt(ghostty.size.CellCountInt) and
+        rows <= std.math.maxInt(ghostty.size.CellCountInt);
+}
+
+export fn cockpit_ghostty_vt_create(columns: u32, rows: u32, scrollback_limit: u64) ?*Bridge {
+    if (!validDimensions(columns, rows) or scrollback_limit > std.math.maxInt(usize)) return null;
+    const bridge = alloc.create(Bridge) catch return null;
+    bridge.io = .init_single_threaded;
+    bridge.terminal = ghostty.Terminal.init(bridge.io.io(), alloc, .{
+        .cols = @intCast(columns),
+        .rows = @intCast(rows),
+        .max_scrollback_lines = @intCast(scrollback_limit),
+    }) catch {
+        bridge.io.deinit();
+        alloc.destroy(bridge);
+        return null;
+    };
+    bridge.stream = bridge.terminal.vtStream();
+    bridge.render_state = .empty;
+    bridge.columns = columns;
+    bridge.rows = rows;
+    bridge.sequence = 0;
+    bridge.primary_history = .{
+        .screen_generation = bridge.terminal.screens.generation(.primary),
+        .page_serial_epoch = bridge.terminal.screens.active.pages.page_serial_epoch,
+    };
+    bridge.alternate_history = .{
+        .screen_generation = bridge.terminal.screens.generation(.alternate),
+    };
+    bridge.next_history_index = 0;
+    bridge.previous_buttons = 0;
+    bridge.wheel_x_remainder = 0;
+    bridge.wheel_y_remainder = 0;
+    return bridge;
+}
+
+export fn cockpit_ghostty_vt_destroy(bridge: ?*Bridge) void {
+    const value = bridge orelse return;
+    freeHistory(&value.primary_history.rows);
+    freeHistory(&value.alternate_history.rows);
+    value.stream.deinit();
+    value.render_state.deinit(alloc);
+    value.terminal.deinit(alloc);
+    value.io.deinit();
+    alloc.destroy(value);
+}
+
+export fn cockpit_ghostty_vt_reset_input_state(bridge: ?*Bridge) void {
+    const value = bridge orelse return;
+    value.previous_buttons = 0;
+    value.wheel_x_remainder = 0;
+    value.wheel_y_remainder = 0;
+}
+
+export fn cockpit_ghostty_vt_feed(bridge: ?*Bridge, data: ?[*]const u8, length: usize) c_int {
+    const value = bridge orelse return -1;
+    if (length > 0 and data == null) return -1;
+    value.stream.nextSlice(if (data) |ptr| ptr[0..length] else "");
+    return 0;
+}
+
+export fn cockpit_ghostty_vt_resize(bridge: ?*Bridge, columns: u32, rows: u32) c_int {
+    const value = bridge orelse return -1;
+    if (!validDimensions(columns, rows)) return -1;
+    const primary_before = value.terminal.screens.get(.primary).?;
+    synchronizeHistoryForScreen(
+        value,
+        primary_before,
+        &value.primary_history,
+        value.terminal.screens.generation(.primary),
+        null,
+    ) catch return -1;
+    var anchors = captureHistoryAnchors(primary_before, &value.primary_history) catch return -1;
+    defer releaseHistoryAnchors(primary_before, &anchors);
+    value.terminal.resize(alloc, .{
+        .cols = @intCast(columns),
+        .rows = @intCast(rows),
+    }) catch return -1;
+    value.columns = columns;
+    value.rows = rows;
+    var relocations = historyRelocations(anchors.items) catch return -1;
+    defer relocations.deinit();
+    const primary_after = value.terminal.screens.get(.primary).?;
+    synchronizeHistoryForScreen(
+        value,
+        primary_after,
+        &value.primary_history,
+        value.terminal.screens.generation(.primary),
+        &relocations,
+    ) catch return -1;
+    return 0;
+}
+
+fn appendSection(frame: *Buffer, section: *const Section) !void {
+    try frame.byte(section.kind);
+    try frame.append(&.{ 0, 0, 0 });
+    try frame.int(u32, @intCast(section.payload.bytes.items.len));
+    try frame.append(section.payload.bytes.items);
+}
+
+fn appendHeader(frame: *Buffer, kind: u8, flags: u8, base: u64, output: u64, rows: u32, columns: u32, section_count: u32) !void {
+    try frame.append("CKGF");
+    try frame.int(u16, 1);
+    try frame.byte(kind);
+    try frame.byte(flags);
+    try frame.int(u64, base);
+    try frame.int(u64, output);
+    try frame.int(u32, rows);
+    try frame.int(u32, columns);
+    try frame.int(u32, section_count);
+}
+
+fn styleIndex(styles: *std.ArrayList(ghostty.Style), style: ghostty.Style) !u32 {
+    if (style.default()) return 0;
+    for (styles.items, 0..) |existing, index| {
+        if (existing.eql(style)) return @intCast(index + 1);
+    }
+    try styles.append(alloc, style);
+    return @intCast(styles.items.len);
+}
+
+fn appendCodepoint(buffer: *Buffer, codepoint: u21) !void {
+    var encoded: [4]u8 = undefined;
+    const length = try std.unicode.utf8Encode(codepoint, &encoded);
+    try buffer.append(encoded[0..length]);
+}
+
+fn colorWire(color: ghostty.Style.Color) struct { u8, u32 } {
+    return switch (color) {
+        .none => .{ 0, 0 },
+        .palette => |index| .{ 1, index },
+        .rgb => |rgb| .{ 2, (@as(u32, rgb.r) << 16) | (@as(u32, rgb.g) << 8) | rgb.b },
+    };
+}
+
+fn serializeViewport(bridge: *Bridge, snapshot: bool) ![]u8 {
+    try bridge.render_state.update(alloc, &bridge.terminal);
+    if (!snapshot and bridge.render_state.dirty == .full) return error.SnapshotRequired;
+    const rows_data = bridge.render_state.row_data.slice();
+    const row_raw = rows_data.items(.raw);
+    const row_cells = rows_data.items(.cells);
+    const row_dirty = rows_data.items(.dirty);
+
+    var selected: std.ArrayList(usize) = .empty;
+    defer selected.deinit(alloc);
+    for (0..bridge.render_state.rows) |row| {
+        if (snapshot or row_dirty[row]) try selected.append(alloc, row);
+    }
+
+    var styles: std.ArrayList(ghostty.Style) = .empty;
+    defer styles.deinit(alloc);
+    var cells: std.ArrayList(CellRef) = .empty;
+    defer cells.deinit(alloc);
+    var graphemes: std.ArrayList(Buffer) = .empty;
+    defer {
+        for (graphemes.items) |*value| value.deinit();
+        graphemes.deinit(alloc);
+    }
+
+    var row_section = Section{ .kind = 3, .payload = .{} };
+    defer row_section.deinit();
+    try row_section.payload.int(u32, @intCast(selected.items.len));
+    for (selected.items) |row| {
+        const first_cell: u32 = @intCast(cells.items.len);
+        const raw_slice = row_cells[row].slice();
+        const raw = raw_slice.items(.raw);
+        const cell_styles = raw_slice.items(.style);
+        const cell_graphemes = raw_slice.items(.grapheme);
+        for (raw, 0..) |cell, column| {
+            if (cell.isEmpty()) continue;
+            var grapheme_index: u32 = 0;
+            if (cell.hasText()) {
+                var grapheme: Buffer = .{};
+                errdefer grapheme.deinit();
+                try appendCodepoint(&grapheme, cell.codepoint());
+                if (cell.content_tag == .codepoint_grapheme) {
+                    for (cell_graphemes[column]) |codepoint| try appendCodepoint(&grapheme, codepoint);
+                }
+                try graphemes.append(alloc, grapheme);
+                grapheme_index = @intCast(graphemes.items.len);
+            }
+            const style = switch (cell.content_tag) {
+                .bg_color_palette => ghostty.Style{ .bg_color = .{ .palette = cell.content.color_palette.data } },
+                .bg_color_rgb => ghostty.Style{ .bg_color = .{ .rgb = .{
+                    .r = cell.content.color_rgb.r,
+                    .g = cell.content.color_rgb.g,
+                    .b = cell.content.color_rgb.b,
+                } } },
+                else => if (cell.style_id == 0) ghostty.Style{} else cell_styles[column],
+            };
+            const style_index = try styleIndex(&styles, style);
+            const width: u8 = switch (cell.wide) {
+                .spacer_head, .spacer_tail => 0,
+                .narrow => 1,
+                .wide => 2,
+            };
+            try cells.append(alloc, .{
+                .row = @intCast(row),
+                .column = @intCast(column),
+                .width = width,
+                .grapheme = grapheme_index,
+                .style = style_index,
+            });
+        }
+        const flags: u8 = 1 | if (row_raw[row].wrap) @as(u8, 2) else 0;
+        try row_section.payload.int(u32, @intCast(row));
+        try row_section.payload.byte(flags);
+        try row_section.payload.append(&.{ 0, 0, 0 });
+        try row_section.payload.int(u32, first_cell);
+        try row_section.payload.int(u32, @intCast(cells.items.len - first_cell));
+    }
+
+    var palette_section = Section{ .kind = 1, .payload = .{} };
+    defer palette_section.deinit();
+    try palette_section.payload.int(u32, 256);
+    for (bridge.render_state.colors.palette, 0..) |rgb, index| {
+        try palette_section.payload.int(u16, @intCast(index));
+        try palette_section.payload.append(&.{ rgb.r, rgb.g, rgb.b, 0 });
+    }
+
+    var cursor_section = Section{ .kind = 2, .payload = .{} };
+    defer cursor_section.deinit();
+    const cursor = bridge.render_state.cursor;
+    var cursor_position: ghostty.RenderState.Cursor.Viewport = cursor.viewport orelse .{ .x = 0, .y = 0, .wide_tail = false };
+    if (cursor_position.wide_tail and cursor_position.x > 0) cursor_position.x -= 1;
+    try cursor_section.payload.int(u32, cursor_position.y);
+    try cursor_section.payload.int(u32, cursor_position.x);
+    try cursor_section.payload.byte(switch (cursor.visual_style) {
+        .block => 1,
+        .bar => 2,
+        .underline => 3,
+        .block_hollow => 1,
+    });
+    try cursor_section.payload.byte(@intFromBool(cursor.visible and cursor.viewport != null));
+    try cursor_section.payload.byte(@intFromBool(cursor.blinking));
+    try cursor_section.payload.byte(0);
+
+    var cell_section = Section{ .kind = 4, .payload = .{} };
+    defer cell_section.deinit();
+    try cell_section.payload.int(u32, @intCast(cells.items.len));
+    for (cells.items) |cell| {
+        try cell_section.payload.int(u32, cell.row);
+        try cell_section.payload.int(u32, cell.column);
+        try cell_section.payload.byte(cell.width);
+        try cell_section.payload.byte(0);
+        try cell_section.payload.int(u16, 0);
+        try cell_section.payload.int(u32, cell.grapheme);
+        try cell_section.payload.int(u32, cell.style);
+    }
+
+    var grapheme_section = Section{ .kind = 5, .payload = .{} };
+    defer grapheme_section.deinit();
+    try grapheme_section.payload.int(u32, @intCast(graphemes.items.len));
+    for (graphemes.items, 0..) |grapheme, index| {
+        try grapheme_section.payload.int(u32, @intCast(index + 1));
+        try grapheme_section.payload.int(u32, @intCast(grapheme.bytes.items.len));
+        try grapheme_section.payload.append(grapheme.bytes.items);
+    }
+
+    var style_section = Section{ .kind = 6, .payload = .{} };
+    defer style_section.deinit();
+    try style_section.payload.int(u32, @intCast(styles.items.len));
+    for (styles.items, 0..) |style, index| {
+        const foreground = colorWire(style.fg_color);
+        const background = colorWire(style.bg_color);
+        const flags: u8 = @intFromBool(style.flags.bold) |
+            (@as(u8, @intFromBool(style.flags.italic)) << 1) |
+            (@as(u8, @intFromBool(style.flags.faint)) << 2) |
+            (@as(u8, @intFromBool(style.flags.blink)) << 3) |
+            (@as(u8, @intFromBool(style.flags.inverse)) << 4) |
+            (@as(u8, @intFromBool(style.flags.invisible)) << 5) |
+            (@as(u8, @intFromBool(style.flags.strikethrough)) << 6) |
+            (@as(u8, @intFromBool(style.flags.overline)) << 7);
+        try style_section.payload.int(u32, @intCast(index + 1));
+        try style_section.payload.byte(foreground[0]);
+        try style_section.payload.byte(background[0]);
+        try style_section.payload.byte(flags);
+        try style_section.payload.byte(@intFromEnum(style.flags.underline));
+        try style_section.payload.int(u32, foreground[1]);
+        try style_section.payload.int(u32, background[1]);
+    }
+
+    const output_sequence = std.math.add(u64, bridge.sequence, 1) catch return error.SequenceOverflow;
+    var frame: Buffer = .{};
+    errdefer frame.deinit();
+    try appendHeader(&frame, if (snapshot) 1 else 2, if (snapshot) 1 else 0, if (snapshot) 0 else bridge.sequence, output_sequence, bridge.rows, bridge.columns, if (snapshot) 6 else 5);
+    if (snapshot) try appendSection(&frame, &palette_section);
+    try appendSection(&frame, &cursor_section);
+    try appendSection(&frame, &row_section);
+    try appendSection(&frame, &cell_section);
+    try appendSection(&frame, &grapheme_section);
+    try appendSection(&frame, &style_section);
+    if (frame.bytes.items.len > maximum_frame_length) return error.FrameTooLarge;
+    bridge.sequence = output_sequence;
+    bridge.render_state.dirty = .false;
+    @memset(bridge.render_state.row_data.items(.dirty), false);
+    return frame.take();
+}
+
+export fn cockpit_ghostty_vt_snapshot(bridge: ?*Bridge, out: ?*Bytes) c_int {
+    empty(out);
+    const value = bridge orelse return -1;
+    const output = out orelse return -1;
+    const bytes = serializeViewport(value, true) catch return -1;
+    return returnBytes(output, bytes);
+}
+
+export fn cockpit_ghostty_vt_delta(bridge: ?*Bridge, base_sequence: u64, out: ?*Bytes) c_int {
+    empty(out);
+    const value = bridge orelse return -1;
+    const output = out orelse return -1;
+    if (base_sequence != value.sequence or base_sequence == 0) return -1;
+    const bytes = serializeViewport(value, false) catch return -1;
+    return returnBytes(output, bytes);
+}
+
+fn freeHistory(rows: *std.ArrayList(HistoryRow)) void {
+    for (rows.items) |row| alloc.free(row.text);
+    rows.deinit(alloc);
+    rows.* = .empty;
+}
+
+fn historyRowText(screen: *const ghostty.Screen, pin: ghostty.Pin) ![]u8 {
+    var writer: std.Io.Writer.Allocating = .init(alloc);
+    defer writer.deinit();
+    var start = pin;
+    start.x = 0;
+    var end = pin;
+    end.x = @intCast(pin.cells(.all).len - 1);
+    try screen.dumpString(&writer.writer, .{
+        .tl = start,
+        .br = end,
+        .unwrap = false,
+    });
+    const rendered = std.mem.trimEnd(u8, writer.writer.buffered(), "\r\n");
+    return alloc.dupe(u8, rendered);
+}
+
+fn takeHistoryIndex(bridge: *Bridge) !u64 {
+    const result = bridge.next_history_index;
+    bridge.next_history_index = try std.math.add(u64, result, 1);
+    return result;
+}
+
+fn historyIdentity(pin: ghostty.Pin) HistoryIdentity {
+    return .{
+        .node = @intFromPtr(pin.node),
+        .serial = pin.node.serial,
+        .row = @intCast(pin.y),
+    };
+}
+
+fn historyContentEqual(left: HistoryRow, right: HistoryRow) bool {
+    return left.wrapped == right.wrapped and std.mem.eql(u8, left.text, right.text);
+}
+
+fn historyIdentityOverlap(old: []const HistoryRow, updated: []const HistoryRow) !usize {
+    var old_indices = std.AutoHashMap(HistoryIdentity, usize).init(alloc);
+    defer old_indices.deinit();
+    for (old, 0..) |row, index| try old_indices.put(row.identity, index);
+
+    var best: usize = 0;
+    for (updated, 0..) |row, updated_index| {
+        const old_index = old_indices.get(row.identity) orelse continue;
+        if (old_index < updated_index) continue;
+        const old_start = old_index - updated_index;
+        const overlap = old.len - old_start;
+        if (overlap <= best or overlap > updated.len) continue;
+        for (0..overlap) |offset| {
+            if (!historyContentEqual(old[old_start + offset], updated[offset])) break;
+        } else {
+            best = overlap;
+        }
+    }
+    return best;
+}
+
+fn captureHistoryAnchors(screen: *ghostty.Screen, cache: *const HistoryCache) !std.ArrayList(HistoryAnchor) {
+    var result: std.ArrayList(HistoryAnchor) = .empty;
+    errdefer releaseHistoryAnchors(screen, &result);
+    if (screen.pages.getBottomRight(.history) == null) return result;
+    var iterator = screen.pages.rowIterator(.right_down, .{ .history = .{} }, null);
+    var index: usize = 0;
+    while (iterator.next()) |pin| : (index += 1) {
+        if (index >= cache.rows.items.len or
+            !std.meta.eql(historyIdentity(pin), cache.rows.items[index].identity))
+            return error.HistoryChanged;
+        var row_pin = pin;
+        row_pin.x = 0;
+        const tracked = try screen.pages.trackPin(row_pin);
+        result.append(alloc, .{
+            .pin = tracked,
+            .absolute_index = cache.rows.items[index].absolute_index,
+        }) catch |err| {
+            screen.pages.untrackPin(tracked);
+            return err;
+        };
+    }
+    if (index != cache.rows.items.len) return error.HistoryChanged;
+    return result;
+}
+
+fn releaseHistoryAnchors(screen: *ghostty.Screen, anchors: *std.ArrayList(HistoryAnchor)) void {
+    for (anchors.items) |anchor| screen.pages.untrackPin(anchor.pin);
+    anchors.deinit(alloc);
+    anchors.* = .empty;
+}
+
+fn historyRelocations(anchors: []const HistoryAnchor) !HistoryRelocations {
+    var result = HistoryRelocations.init(alloc);
+    errdefer result.deinit();
+    for (anchors) |anchor| {
+        if (anchor.pin.garbage) continue;
+        const identity = historyIdentity(anchor.pin.*);
+        const entry = try result.getOrPut(identity);
+        if (!entry.found_existing or anchor.absolute_index < entry.value_ptr.*) {
+            entry.value_ptr.* = anchor.absolute_index;
+        }
+    }
+    return result;
+}
+
+fn synchronizeHistoryForScreen(
+    bridge: *Bridge,
+    screen: *ghostty.Screen,
+    cache: *HistoryCache,
+    screen_generation: usize,
+    relocations: ?*const HistoryRelocations,
+) !void {
+    const history_epoch = screen.pages.page_serial_epoch;
+    var updated: std.ArrayList(HistoryRow) = .empty;
+    errdefer freeHistory(&updated);
+    if (screen.pages.getBottomRight(.history) != null) {
+        var iterator = screen.pages.rowIterator(.right_down, .{ .history = .{} }, null);
+        while (iterator.next()) |pin| {
+            const identity = historyIdentity(pin);
+            const text = try historyRowText(screen, pin);
+            updated.append(alloc, .{
+                .identity = identity,
+                .absolute_index = 0,
+                .text = text,
+                .wrapped = pin.rowAndCell().row.wrap,
+            }) catch |err| {
+                alloc.free(text);
+                return err;
+            };
+        }
+    }
+
+    if (relocations) |mapped| {
+        var retain = true;
+        var previous: ?u64 = null;
+        for (updated.items) |*row| {
+            const relocated = if (retain) mapped.get(row.identity) else null;
+            if (relocated) |absolute_index| {
+                if (previous == null or absolute_index > previous.?) {
+                    row.absolute_index = absolute_index;
+                    previous = absolute_index;
+                    continue;
+                }
+            }
+            retain = false;
+            row.absolute_index = try takeHistoryIndex(bridge);
+        }
+    } else {
+        const overlap = if (cache.screen_generation == screen_generation and
+            cache.page_serial_epoch == history_epoch)
+            try historyIdentityOverlap(cache.rows.items, updated.items)
+        else
+            0;
+        const old_start = cache.rows.items.len - overlap;
+        for (updated.items, 0..) |*row, index| {
+            if (index < overlap) {
+                row.absolute_index = cache.rows.items[old_start + index].absolute_index;
+            } else {
+                row.absolute_index = try takeHistoryIndex(bridge);
+            }
+        }
+    }
+
+    freeHistory(&cache.rows);
+    cache.rows = updated;
+    cache.screen_generation = screen_generation;
+    cache.page_serial_epoch = history_epoch;
+}
+
+export fn cockpit_ghostty_vt_scrollback(bridge: ?*Bridge, start: u64, count: u32, out: ?*Bytes) c_int {
+    empty(out);
+    const value = bridge orelse return -1;
+    const output = out orelse return -1;
+    const active_key = value.terminal.screens.active_key;
+    const cache = if (active_key == .primary)
+        &value.primary_history
+    else
+        &value.alternate_history;
+    synchronizeHistoryForScreen(
+        value,
+        value.terminal.screens.active,
+        cache,
+        value.terminal.screens.generation(active_key),
+        null,
+    ) catch return -1;
+    var first: usize = 0;
+    while (first < cache.rows.items.len and cache.rows.items[first].absolute_index < start) : (first += 1) {}
+    const returned: usize = @min(@as(usize, count), cache.rows.items.len - first);
+    var section = Section{ .kind = 7, .payload = .{} };
+    defer section.deinit();
+    section.payload.int(u64, start) catch return -1;
+    section.payload.int(u32, @intCast(returned)) catch return -1;
+    section.payload.int(u32, 0) catch return -1;
+    for (cache.rows.items[first .. first + returned]) |row| {
+        section.payload.int(u64, row.absolute_index) catch return -1;
+        section.payload.byte(@intFromBool(row.wrapped)) catch return -1;
+        section.payload.append(&.{ 0, 0, 0 }) catch return -1;
+        section.payload.int(u32, @intCast(row.text.len)) catch return -1;
+        section.payload.append(row.text) catch return -1;
+    }
+    const output_sequence = if (value.sequence == 0) @as(u64, 1) else value.sequence;
+    var frame: Buffer = .{};
+    errdefer frame.deinit();
+    appendHeader(&frame, 3, 0, value.sequence, output_sequence, value.rows, value.columns, 1) catch return -1;
+    appendSection(&frame, &section) catch return -1;
+    if (frame.bytes.items.len > maximum_frame_length) return -1;
+    const owned = frame.take() catch return -1;
+    return returnBytes(output, owned);
+}
+
+fn modifiers(value: u32) ?ghostty.input.KeyMods {
+    if ((value & ~@as(u32, 0x3FF)) != 0) return null;
+    return .{
+        .shift = (value & (1 << 0)) != 0,
+        .ctrl = (value & (1 << 1)) != 0,
+        .alt = (value & (1 << 2)) != 0,
+        .super = (value & (1 << 3)) != 0,
+        .caps_lock = (value & (1 << 4)) != 0,
+        .num_lock = (value & (1 << 5)) != 0,
+        .sides = .{
+            .shift = if ((value & (1 << 6)) != 0) .right else .left,
+            .ctrl = if ((value & (1 << 7)) != 0) .right else .left,
+            .alt = if ((value & (1 << 8)) != 0) .right else .left,
+            .super = if ((value & (1 << 9)) != 0) .right else .left,
+        },
+    };
+}
+
+fn physicalKey(usage: u32) ghostty.input.Key {
+    const letters = [_]ghostty.input.Key{ .key_a, .key_b, .key_c, .key_d, .key_e, .key_f, .key_g, .key_h, .key_i, .key_j, .key_k, .key_l, .key_m, .key_n, .key_o, .key_p, .key_q, .key_r, .key_s, .key_t, .key_u, .key_v, .key_w, .key_x, .key_y, .key_z };
+    const digits = [_]ghostty.input.Key{ .digit_1, .digit_2, .digit_3, .digit_4, .digit_5, .digit_6, .digit_7, .digit_8, .digit_9, .digit_0 };
+    const f1_to_f12 = [_]ghostty.input.Key{ .f1, .f2, .f3, .f4, .f5, .f6, .f7, .f8, .f9, .f10, .f11, .f12 };
+    const numpad_digits = [_]ghostty.input.Key{ .numpad_1, .numpad_2, .numpad_3, .numpad_4, .numpad_5, .numpad_6, .numpad_7, .numpad_8, .numpad_9, .numpad_0 };
+    const f13_to_f24 = [_]ghostty.input.Key{ .f13, .f14, .f15, .f16, .f17, .f18, .f19, .f20, .f21, .f22, .f23, .f24 };
+    if (usage >= 0x04 and usage <= 0x1D) return letters[usage - 0x04];
+    if (usage >= 0x1E and usage <= 0x27) return digits[usage - 0x1E];
+    if (usage >= 0x3A and usage <= 0x45) return f1_to_f12[usage - 0x3A];
+    if (usage >= 0x59 and usage <= 0x62) return numpad_digits[usage - 0x59];
+    if (usage >= 0x68 and usage <= 0x73) return f13_to_f24[usage - 0x68];
+    return switch (usage) {
+        0 => .unidentified,
+        0x28 => .enter,
+        0x29 => .escape,
+        0x2A => .backspace,
+        0x2B => .tab,
+        0x2C => .space,
+        0x2D => .minus,
+        0x2E => .equal,
+        0x2F => .bracket_left,
+        0x30 => .bracket_right,
+        0x31 => .backslash,
+        0x33 => .semicolon,
+        0x34 => .quote,
+        0x35 => .backquote,
+        0x36 => .comma,
+        0x37 => .period,
+        0x38 => .slash,
+        0x39 => .caps_lock,
+        0x46 => .print_screen,
+        0x47 => .scroll_lock,
+        0x48 => .pause,
+        0x49 => .insert,
+        0x4A => .home,
+        0x4B => .page_up,
+        0x4C => .delete,
+        0x4D => .end,
+        0x4E => .page_down,
+        0x4F => .arrow_right,
+        0x50 => .arrow_left,
+        0x51 => .arrow_down,
+        0x52 => .arrow_up,
+        0x53 => .num_lock,
+        0x54 => .numpad_divide,
+        0x55 => .numpad_multiply,
+        0x56 => .numpad_subtract,
+        0x57 => .numpad_add,
+        0x58 => .numpad_enter,
+        0x63 => .numpad_decimal,
+        0x64 => .intl_backslash,
+        0x65 => .context_menu,
+        0x66 => .power,
+        0x67 => .numpad_equal,
+        0x75 => .help,
+        0x7B => .cut,
+        0x7C => .copy,
+        0x7D => .paste,
+        0x7F => .audio_volume_mute,
+        0x80 => .audio_volume_up,
+        0x81 => .audio_volume_down,
+        0x85 => .numpad_comma,
+        0x87 => .intl_ro,
+        0x88 => .kana_mode,
+        0x89 => .intl_yen,
+        0x8A => .convert,
+        0x8B => .non_convert,
+        0xB6 => .numpad_paren_left,
+        0xB7 => .numpad_paren_right,
+        0xBB => .numpad_backspace,
+        0xD0 => .numpad_memory_store,
+        0xD1 => .numpad_memory_recall,
+        0xD2 => .numpad_memory_clear,
+        0xD3 => .numpad_memory_add,
+        0xD4 => .numpad_memory_subtract,
+        0xD8 => .numpad_clear,
+        0xD9 => .numpad_clear_entry,
+        0xE0 => .control_left,
+        0xE1 => .shift_left,
+        0xE2 => .alt_left,
+        0xE3 => .meta_left,
+        0xE4 => .control_right,
+        0xE5 => .shift_right,
+        0xE6 => .alt_right,
+        0xE7 => .meta_right,
+        else => .unidentified,
+    };
+}
+
+fn writerBytes(writer: *std.Io.Writer.Allocating, out: *Bytes) c_int {
+    const written = writer.writer.buffered();
+    if (written.len == 0) {
+        out.* = .{ .bytes = null, .length = 0 };
+        return 0;
+    }
+    const owned = alloc.dupe(u8, written) catch return -1;
+    return returnBytes(out, owned);
+}
+
+export fn cockpit_ghostty_vt_encode_key(bridge: ?*Bridge, event: ?*const KeyEvent, out: ?*Bytes) c_int {
+    empty(out);
+    const value = bridge orelse return -1;
+    const input = event orelse return -1;
+    const output = out orelse return -1;
+    if (!std.mem.allEqual(u8, &input.reserved, 0) or
+        input.logical_key > 0x10FFFF or (input.logical_key >= 0xD800 and input.logical_key <= 0xDFFF) or
+        (input.logical_key == 0 and input.physical_key == 0)) return -1;
+    const mods = modifiers(input.modifiers) orelse return -1;
+    const action: ghostty.input.KeyAction = switch (input.action) {
+        1 => .press,
+        2 => .repeat,
+        3 => .release,
+        else => return -1,
+    };
+    const key = physicalKey(input.physical_key);
+    if (key == .unidentified and input.logical_key == 0) return -1;
+    var writer: std.Io.Writer.Allocating = .init(alloc);
+    defer writer.deinit();
+    ghostty.input.encodeKey(&writer.writer, .{
+        .action = action,
+        .key = key,
+        .mods = mods,
+        .utf8 = "",
+        .unshifted_codepoint = @intCast(input.logical_key),
+    }, .fromTerminal(&value.terminal)) catch return -1;
+    return writerBytes(&writer, output);
+}
+
+export fn cockpit_ghostty_vt_encode_paste(bridge: ?*Bridge, data: ?[*]const u8, length: usize, out: ?*Bytes) c_int {
+    empty(out);
+    const value = bridge orelse return -1;
+    const output = out orelse return -1;
+    if (length > 0 and data == null) return -1;
+    const input = if (data) |ptr| ptr[0..length] else "";
+    const copy = alloc.dupe(u8, input) catch return -1;
+    defer alloc.free(copy);
+    const encoded = ghostty.input.encodePaste(copy, .fromTerminal(&value.terminal));
+    var buffer: Buffer = .{};
+    defer buffer.deinit();
+    for (encoded) |part| buffer.append(part) catch return -1;
+    const owned = buffer.take() catch return -1;
+    return returnBytes(output, owned);
+}
+
+const MouseAction = enum { press, release, motion };
+
+fn mouseButtonCode(index: u5) ?u8 {
+    return switch (index) {
+        0 => 0,
+        1 => 2,
+        2 => 1,
+        3...6 => @as(u8, 64) + @as(u8, @intCast(index - 3)),
+        7...10 => @as(u8, 128) + @as(u8, @intCast(index - 7)),
+        else => null,
+    };
+}
+
+fn firstMouseButton(buttons: u32) ?u8 {
+    if (buttons == 0) return null;
+    return mouseButtonCode(@intCast(@ctz(buttons)));
+}
+
+fn mouseOutsideViewport(bridge: *const Bridge, input: *const MouseEvent) bool {
+    return input.cell_x < 0 or input.cell_y < 0 or
+        input.cell_x >= bridge.columns or input.cell_y >= bridge.rows;
+}
+
+fn mouseModeSendsMotion(bridge: *const Bridge) bool {
+    return bridge.terminal.flags.mouse_event == .button or
+        bridge.terminal.flags.mouse_event == .any;
+}
+
+fn writeMouseCode(writer: *std.Io.Writer, bridge: *Bridge, input: *const MouseEvent, action: MouseAction, base_code: u8) !bool {
+    var code = base_code;
+    if (bridge.terminal.flags.mouse_event == .x10 and (action != .press or code > 2)) return false;
+    if (bridge.terminal.flags.mouse_event == .normal and action == .motion) return false;
+    if (bridge.terminal.flags.mouse_event == .button and action == .motion and input.buttons == 0) return false;
+    if (bridge.terminal.flags.mouse_event != .x10) {
+        if ((input.modifiers & 1) != 0) code +|= 4;
+        if ((input.modifiers & 4) != 0) code +|= 8;
+        if ((input.modifiers & 2) != 0) code +|= 16;
+    }
+    if (action == .motion) code +|= 32;
+    const cell_x: i32 = std.math.clamp(input.cell_x, 0, @as(i32, @intCast(bridge.columns - 1)));
+    const cell_y: i32 = std.math.clamp(input.cell_y, 0, @as(i32, @intCast(bridge.rows - 1)));
+    switch (bridge.terminal.flags.mouse_format) {
+        .x10 => {
+            if (cell_x > 222 or cell_y > 222) return false;
+            try writer.writeAll(&.{ 0x1B, '[', 'M', 32 + code, @intCast(33 + cell_x), @intCast(33 + cell_y) });
+        },
+        .utf8 => {
+            try writer.writeAll(&.{ 0x1B, '[', 'M', 32 + code });
+            try writer.printUnicodeCodepoint(@intCast(33 + cell_x));
+            try writer.printUnicodeCodepoint(@intCast(33 + cell_y));
+        },
+        .sgr => try writer.print("\x1B[<{d};{d};{d}{c}", .{ code, cell_x + 1, cell_y + 1, if (action == .release) @as(u8, 'm') else 'M' }),
+        .urxvt => try writer.print("\x1B[{d};{d};{d}M", .{ 32 + code, cell_x + 1, cell_y + 1 }),
+        .sgr_pixels => return error.PixelCoordinatesUnavailable,
+    }
+    return true;
+}
+
+export fn cockpit_ghostty_vt_encode_mouse(bridge: ?*Bridge, event: ?*const MouseEvent, out: ?*Bytes) c_int {
+    empty(out);
+    const value = bridge orelse return -1;
+    const input = event orelse return -1;
+    const output = out orelse return -1;
+    if (!std.mem.allEqual(u8, &input.reserved, 0) or (input.buttons & ~@as(u32, 0x7FF)) != 0 or
+        input.action < 1 or input.action > 4 or
+        modifiers(input.modifiers) == null) return -1;
+    if (input.action == 4) {
+        if (input.wheel_x == 0 and input.wheel_y == 0) return -1;
+    } else if (input.wheel_x != 0 or input.wheel_y != 0) return -1;
+    if (value.terminal.flags.mouse_format == .sgr_pixels) return -1;
+    const action: MouseAction = switch (input.action) {
+        1, 4 => .press,
+        2 => .release,
+        3 => .motion,
+        else => unreachable,
+    };
+    var writer: std.Io.Writer.Allocating = .init(alloc);
+    defer writer.deinit();
+    if (input.action == 4) {
+        if (value.terminal.flags.mouse_event == .none) return 0;
+        if (value.terminal.flags.mouse_event == .x10) return 0;
+        if (mouseOutsideViewport(value, input)) return 0;
+        const total_x = value.wheel_x_remainder + @as(i64, input.wheel_x);
+        const total_y = value.wheel_y_remainder + @as(i64, input.wheel_y);
+        const steps_x = @divTrunc(total_x, 65536);
+        const steps_y = @divTrunc(total_y, 65536);
+        var count: u64 = @intCast(@abs(steps_y));
+        while (count > 0) : (count -= 1) {
+            const code: u8 = if (steps_y > 0) 64 else 65;
+            _ = writeMouseCode(&writer.writer, value, input, .press, code) catch return -1;
+        }
+        count = @intCast(@abs(steps_x));
+        while (count > 0) : (count -= 1) {
+            const code: u8 = if (steps_x < 0) 66 else 67;
+            _ = writeMouseCode(&writer.writer, value, input, .press, code) catch return -1;
+        }
+        const result = writerBytes(&writer, output);
+        if (result == 0) {
+            value.wheel_x_remainder = @rem(total_x, 65536);
+            value.wheel_y_remainder = @rem(total_y, 65536);
+        }
+        return result;
+    }
+    const code: u8 = switch (action) {
+        .press, .release => changed: {
+            const changed_buttons = value.previous_buttons ^ input.buttons;
+            if (@popCount(changed_buttons) != 1) return -1;
+            const changed_mask = changed_buttons & (0 -% changed_buttons);
+            if ((action == .press) != ((input.buttons & changed_mask) != 0)) return -1;
+            break :changed mouseButtonCode(@intCast(@ctz(changed_mask))) orelse return -1;
+        },
+        .motion => motion: {
+            if (input.buttons != value.previous_buttons) return -1;
+            break :motion firstMouseButton(input.buttons) orelse 3;
+        },
+    };
+    if (action != .release and mouseOutsideViewport(value, input) and
+        (!mouseModeSendsMotion(value) or input.buttons == 0))
+    {
+        if (action != .motion) value.previous_buttons = input.buttons;
+        return 0;
+    }
+    if (value.terminal.flags.mouse_event == .none) {
+        if (action != .motion) value.previous_buttons = input.buttons;
+        return 0;
+    }
+    if (!(writeMouseCode(&writer.writer, value, input, action, code) catch return -1)) {
+        if (action != .motion) value.previous_buttons = input.buttons;
+        return 0;
+    }
+    const result = writerBytes(&writer, output);
+    if (result == 0 and action != .motion) value.previous_buttons = input.buttons;
+    return result;
+}
+
+export fn cockpit_ghostty_bytes_free(bytes: Bytes) void {
+    if (bytes.bytes) |pointer| {
+        if (bytes.length > 0) alloc.free(@constCast(pointer[0..bytes.length]));
+    }
+}
+
+fn testSection(frame: []const u8, wanted: u8) ![]const u8 {
+    if (frame.len < 36) return error.InvalidFrame;
+    const count = std.mem.readInt(u32, frame[32..36], .big);
+    var offset: usize = 36;
+    for (0..count) |_| {
+        if (frame.len - offset < 8) return error.InvalidFrame;
+        const kind = frame[offset];
+        const length: usize = std.mem.readInt(u32, frame[offset + 4 ..][0..4], .big);
+        offset += 8;
+        if (length > frame.len - offset) return error.InvalidFrame;
+        if (kind == wanted) return frame[offset .. offset + length];
+        offset += length;
+    }
+    return error.MissingSection;
+}
+
+test "cockpit bridge hides an off-viewport cursor" {
+    const bridge = cockpit_ghostty_vt_create(4, 2, 128).?;
+    defer cockpit_ghostty_vt_destroy(bridge);
+    const lines = "one\r\ntwo\r\nthree\r\nfour";
+    try std.testing.expectEqual(@as(c_int, 0), cockpit_ghostty_vt_feed(bridge, lines.ptr, lines.len));
+    bridge.terminal.scrollViewport(.top);
+    var bytes: Bytes = .{ .bytes = null, .length = 0 };
+    try std.testing.expectEqual(@as(c_int, 0), cockpit_ghostty_vt_snapshot(bridge, &bytes));
+    defer cockpit_ghostty_bytes_free(bytes);
+    const frame = bytes.bytes.?[0..bytes.length];
+    const cursor = try testSection(frame, 2);
+    try std.testing.expectEqual(@as(usize, 12), cursor.len);
+    try std.testing.expectEqual(@as(u32, 0), std.mem.readInt(u32, cursor[0..4], .big));
+    try std.testing.expectEqual(@as(u32, 0), std.mem.readInt(u32, cursor[4..8], .big));
+    try std.testing.expectEqual(@as(u8, 0), cursor[9]);
+}
