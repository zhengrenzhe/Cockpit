diff --git a/build.zig b/build.zig
index acf19ac91fb219b65ea08ea46b854bcf1893a759..fceb541a04ade71a553b12f871fd1327cbc01084 100644
--- a/build.zig
+++ b/build.zig
@@ -175,0 +176,5 @@ pub fn build(b: *std.Build) !void {
+    // Cockpit's embedding boundary is additive and does not use Surface,
+    // because Surface owns its PTY. These artifacts consume libghostty-vt
+    // state from an externally owned PTY instead.
+    try @import("src/cockpit/build.zig").add(b, &config, &mod);
+
diff --git a/src/cockpit/build.zig b/src/cockpit/build.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b2adb5d61e770173f2cbfe2da660da129c52442d
--- /dev/null
+++ b/src/cockpit/build.zig
@@ -0,0 +1,102 @@
+const std = @import("std");
+const CombineArchivesStep = @import("../build/CombineArchivesStep.zig");
+const Config = @import("../build/Config.zig");
+const GhosttyZig = @import("../build/GhosttyZig.zig");
+const LibsystemOverrideStep = @import("../build/LibsystemOverrideStep.zig");
+
+pub fn add(b: *std.Build, config: *const Config, ghostty: *const GhosttyZig) !void {
+    const vt_module = b.createModule(.{
+        .root_source_file = b.path("src/cockpit/vt.zig"),
+        .target = config.target,
+        .optimize = config.optimize,
+        .link_libc = true,
+    });
+    vt_module.addImport("ghostty-vt", ghostty.vt_c);
+    const vt = b.addLibrary(.{
+        .name = "CockpitGhosttyVT",
+        .linkage = .static,
+        .root_module = vt_module,
+    });
+    vt.use_llvm = true;
+    vt.bundle_compiler_rt = true;
+    vt.bundle_ubsan_rt = true;
+    vt.root_module.pic = true;
+    var vt_sources: std.ArrayList(std.Build.LazyPath) = .empty;
+    try vt_sources.append(b.allocator, vt.getEmittedBin());
+    try vt_sources.appendSlice(b.allocator, ghostty.simd_libs.items);
+    const vt_combined = CombineArchivesStep.create(
+        b,
+        config.target,
+        "CockpitGhosttyVT",
+        vt_sources.items,
+    );
+    vt_combined.step.dependOn(&vt.step);
+    const vt_override = LibsystemOverrideStep.create(
+        b,
+        config.target,
+        vt_combined.output,
+        "libCockpitGhosttyVT.a",
+    );
+    const vt_install = b.addInstallFileWithDir(
+        vt_override.output,
+        .lib,
+        "libCockpitGhosttyVT.a",
+    );
+    const vt_step = b.step("cockpit-ghostty-vt", "Build the Cockpit Ghostty VT bridge");
+    vt_step.dependOn(&vt_install.step);
+
+    const vt_tests = b.addTest(.{
+        .root_module = vt_module,
+        .filters = &.{"cockpit bridge"},
+    });
+    vt_tests.use_llvm = true;
+    const run_vt_tests = b.addRunArtifact(vt_tests);
+    const vt_test_step = b.step("cockpit-ghostty-tests", "Run Cockpit Ghostty bridge tests");
+    vt_test_step.dependOn(&run_vt_tests.step);
+
+    const renderer_module = b.createModule(.{
+        .root_source_file = b.path("src/cockpit/renderer.zig"),
+        .target = config.target,
+        .optimize = config.optimize,
+        .link_libc = true,
+    });
+    const renderer = b.addLibrary(.{
+        .name = "CockpitGhosttyRenderer",
+        .linkage = .static,
+        .root_module = renderer_module,
+    });
+    renderer.use_llvm = true;
+    renderer.bundle_compiler_rt = true;
+    renderer.bundle_ubsan_rt = true;
+    renderer.root_module.pic = true;
+    renderer.root_module.addIncludePath(b.path("src/cockpit/include"));
+    renderer.root_module.addCSourceFile(.{
+        .file = b.path("src/cockpit/renderer.m"),
+        .flags = &.{ "-fobjc-arc", "-fmodules" },
+    });
+    renderer.root_module.linkFramework("AppKit", .{});
+    renderer.root_module.linkFramework("Foundation", .{});
+    renderer.root_module.linkFramework("Metal", .{});
+    renderer.root_module.linkFramework("QuartzCore", .{});
+    try @import("apple_sdk").addPaths(b, renderer);
+    const renderer_combined = CombineArchivesStep.create(
+        b,
+        config.target,
+        "CockpitGhosttyRenderer",
+        &.{renderer.getEmittedBin()},
+    );
+    renderer_combined.step.dependOn(&renderer.step);
+    const renderer_override = LibsystemOverrideStep.create(
+        b,
+        config.target,
+        renderer_combined.output,
+        "libCockpitGhosttyRenderer.a",
+    );
+    const renderer_install = b.addInstallFileWithDir(
+        renderer_override.output,
+        .lib,
+        "libCockpitGhosttyRenderer.a",
+    );
+    const renderer_step = b.step("cockpit-ghostty-renderer", "Build the Cockpit Ghostty Metal renderer bridge");
+    renderer_step.dependOn(&renderer_install.step);
+}
diff --git a/src/cockpit/renderer.m b/src/cockpit/renderer.m
new file mode 100644
index 0000000000000000000000000000000000000000..02a64b11a3506e084f379e2788e0f9faf8c1b014
--- /dev/null
+++ b/src/cockpit/renderer.m
@@ -0,0 +1,911 @@
+#import <AppKit/AppKit.h>
+#import <Metal/Metal.h>
+#import <QuartzCore/CAMetalLayer.h>
+#import <CockpitGhostty/cockpit_ghostty.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum {
+  CKGF_HEADER_LENGTH = 36,
+  CKGF_MAXIMUM_LENGTH = 16 * 1024 * 1024,
+};
+
+typedef struct {
+  uint8_t red;
+  uint8_t green;
+  uint8_t blue;
+} cockpit_rgb_t;
+
+typedef struct {
+  uint32_t row;
+  uint32_t column;
+  uint8_t width;
+  uint8_t foreground_kind;
+  uint8_t background_kind;
+  uint8_t flags;
+  uint8_t underline;
+  uint32_t foreground;
+  uint32_t background;
+  char *text;
+  uint32_t text_length;
+} cockpit_render_cell_t;
+
+typedef struct {
+  uint8_t kind;
+  uint8_t flags;
+  uint64_t base_sequence;
+  uint64_t output_sequence;
+  uint32_t rows;
+  uint32_t columns;
+  const uint8_t *sections[8];
+  size_t section_lengths[8];
+  uint32_t palette_count;
+  uint32_t row_count;
+  uint32_t cell_count;
+  uint32_t grapheme_count;
+  uint32_t style_count;
+} cockpit_frame_t;
+
+struct cockpit_ghostty_renderer {
+  __strong NSView *view;
+  __strong CAMetalLayer *layer;
+  __strong CALayer *original_layer;
+  __strong id<MTLDevice> device;
+  __strong id<MTLCommandQueue> command_queue;
+  __strong id<MTLTexture> upload_texture;
+  __strong id<MTLTexture> offscreen_texture;
+  cockpit_render_cell_t *cells;
+  size_t cell_count;
+  cockpit_rgb_t palette[256];
+  uint32_t rows;
+  uint32_t columns;
+  uint32_t cursor_row;
+  uint32_t cursor_column;
+  uint8_t cursor_shape;
+  bool cursor_visible;
+  bool cursor_blinking;
+  uint64_t sequence;
+  uint32_t pixels_w;
+  uint32_t pixels_h;
+  double scale;
+  bool has_viewport;
+  bool visible;
+  bool original_wants_layer;
+};
+
+static void initialize_palette(cockpit_rgb_t *palette);
+
+static uint16_t read_u16(const uint8_t *bytes) {
+  return ((uint16_t)bytes[0] << 8) | bytes[1];
+}
+
+static uint32_t read_u32(const uint8_t *bytes) {
+  return ((uint32_t)bytes[0] << 24) | ((uint32_t)bytes[1] << 16) |
+         ((uint32_t)bytes[2] << 8) | bytes[3];
+}
+
+static uint64_t read_u64(const uint8_t *bytes) {
+  return ((uint64_t)read_u32(bytes) << 32) | read_u32(bytes + 4);
+}
+
+static bool zero3(const uint8_t *bytes) {
+  return bytes[0] == 0 && bytes[1] == 0 && bytes[2] == 0;
+}
+
+static bool validate_palette(cockpit_frame_t *frame, const uint8_t *payload,
+                             size_t length) {
+  if (length < 4) return false;
+  uint32_t count = read_u32(payload);
+  if (count > 256 || length != 4 + (size_t)count * 6) return false;
+  uint16_t previous = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    const uint8_t *entry = payload + 4 + (size_t)i * 6;
+    uint16_t index = read_u16(entry);
+    if (index > 255 || entry[5] != 0 || (i > 0 && index <= previous))
+      return false;
+    previous = index;
+  }
+  frame->palette_count = count;
+  return true;
+}
+
+static bool validate_cursor(const uint8_t *payload, size_t length,
+                            uint32_t rows, uint32_t columns) {
+  return length == 12 && read_u32(payload) < rows &&
+         read_u32(payload + 4) < columns && payload[8] >= 1 &&
+         payload[8] <= 3 && payload[9] <= 1 && payload[10] <= 1 &&
+         payload[11] == 0;
+}
+
+static bool validate_rows(cockpit_frame_t *frame, const uint8_t *payload,
+                          size_t length) {
+  if (length < 4) return false;
+  uint32_t count = read_u32(payload);
+  if (count > frame->rows || length != 4 + (size_t)count * 16)
+    return false;
+  uint32_t previous = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    const uint8_t *entry = payload + 4 + (size_t)i * 16;
+    uint32_t row = read_u32(entry);
+    if (row >= frame->rows || (entry[4] & ~0x03) != 0 ||
+        (entry[4] & 0x01) == 0 || !zero3(entry + 5) ||
+        (i > 0 && row <= previous))
+      return false;
+    previous = row;
+  }
+  frame->row_count = count;
+  return true;
+}
+
+static bool validate_cells(cockpit_frame_t *frame, const uint8_t *payload,
+                           size_t length) {
+  if (length < 4) return false;
+  uint32_t count = read_u32(payload);
+  if (count > CKGF_MAXIMUM_LENGTH / 20 ||
+      length != 4 + (size_t)count * 20)
+    return false;
+  uint32_t previous_row = 0;
+  uint32_t previous_column = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    const uint8_t *entry = payload + 4 + (size_t)i * 20;
+    uint32_t row = read_u32(entry);
+    uint32_t column = read_u32(entry + 4);
+    if (row >= frame->rows || column >= frame->columns || entry[8] > 2 ||
+        entry[9] != 0 || read_u16(entry + 10) != 0 ||
+        (i > 0 && (row < previous_row ||
+                   (row == previous_row && column <= previous_column))))
+      return false;
+    previous_row = row;
+    previous_column = column;
+  }
+  frame->cell_count = count;
+  return true;
+}
+
+static bool validate_graphemes(cockpit_frame_t *frame,
+                               const uint8_t *payload, size_t length) {
+  if (length < 4) return false;
+  uint32_t count = read_u32(payload);
+  size_t offset = 4;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (length - offset < 8) return false;
+    uint32_t index = read_u32(payload + offset);
+    uint32_t byte_length = read_u32(payload + offset + 4);
+    offset += 8;
+    if (index != i + 1 || byte_length == 0 || byte_length > length - offset)
+      return false;
+    CFStringRef value = CFStringCreateWithBytes(
+        kCFAllocatorDefault, payload + offset, byte_length,
+        kCFStringEncodingUTF8, false);
+    if (value == NULL) return false;
+    CFRelease(value);
+    offset += byte_length;
+  }
+  frame->grapheme_count = count;
+  return offset == length;
+}
+
+static bool validate_styles(cockpit_frame_t *frame, const uint8_t *payload,
+                            size_t length) {
+  if (length < 4) return false;
+  uint32_t count = read_u32(payload);
+  if (length != 4 + (size_t)count * 16) return false;
+  for (uint32_t i = 0; i < count; ++i) {
+    const uint8_t *entry = payload + 4 + (size_t)i * 16;
+    uint8_t foreground_kind = entry[4];
+    uint8_t background_kind = entry[5];
+    if (read_u32(entry) != i + 1 || foreground_kind > 2 ||
+        background_kind > 2 || entry[7] > 5)
+      return false;
+    uint32_t foreground = read_u32(entry + 8);
+    uint32_t background = read_u32(entry + 12);
+    if ((foreground_kind == 0 && foreground != 0) ||
+        (foreground_kind == 1 && foreground > 255) ||
+        (foreground_kind == 2 && foreground > 0xFFFFFF) ||
+        (background_kind == 0 && background != 0) ||
+        (background_kind == 1 && background > 255) ||
+        (background_kind == 2 && background > 0xFFFFFF))
+      return false;
+  }
+  frame->style_count = count;
+  return true;
+}
+
+static bool validate_scrollback(const uint8_t *payload, size_t length) {
+  if (length < 16) return false;
+  uint64_t requested = read_u64(payload);
+  uint32_t count = read_u32(payload + 8);
+  if (read_u32(payload + 12) != 0) return false;
+  size_t offset = 16;
+  uint64_t previous = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (length - offset < 16) return false;
+    uint64_t index = read_u64(payload + offset);
+    if (index < requested || (i > 0 && index <= previous) ||
+        payload[offset + 8] > 1 || !zero3(payload + offset + 9))
+      return false;
+    previous = index;
+    uint32_t byte_length = read_u32(payload + offset + 12);
+    offset += 16;
+    if (byte_length > length - offset) return false;
+    CFStringRef value = CFStringCreateWithBytes(
+        kCFAllocatorDefault, payload + offset, byte_length,
+        kCFStringEncodingUTF8, false);
+    if (value == NULL && byte_length != 0) return false;
+    if (value != NULL) CFRelease(value);
+    offset += byte_length;
+  }
+  return offset == length;
+}
+
+static bool validate_cross_references(const cockpit_frame_t *frame) {
+  const uint8_t *rows = frame->sections[3];
+  const uint8_t *cells = frame->sections[4];
+  uint32_t consumed_cells = 0;
+  for (uint32_t i = 0; i < frame->row_count; ++i) {
+    const uint8_t *row_entry = rows + 4 + (size_t)i * 16;
+    uint32_t row = read_u32(row_entry);
+    uint32_t first = read_u32(row_entry + 8);
+    uint32_t count = read_u32(row_entry + 12);
+    if (first != consumed_cells || first > frame->cell_count ||
+        count > frame->cell_count - first)
+      return false;
+    for (uint32_t cell_index = first; cell_index < first + count;
+         ++cell_index) {
+      const uint8_t *cell = cells + 4 + (size_t)cell_index * 20;
+      if (read_u32(cell) != row) return false;
+    }
+    consumed_cells += count;
+  }
+  if (consumed_cells != frame->cell_count) return false;
+  for (uint32_t i = 0; i < frame->cell_count; ++i) {
+    const uint8_t *cell = cells + 4 + (size_t)i * 20;
+    if (read_u32(cell + 12) > frame->grapheme_count ||
+        read_u32(cell + 16) > frame->style_count)
+      return false;
+  }
+  if (frame->kind == 1) {
+    if (frame->row_count != frame->rows) return false;
+    for (uint32_t i = 0; i < frame->row_count; ++i) {
+      if (read_u32(rows + 4 + (size_t)i * 16) != i) return false;
+    }
+  }
+  return true;
+}
+
+static bool validate_frame(const uint8_t *bytes, size_t length,
+                           cockpit_frame_t *frame) {
+  memset(frame, 0, sizeof(*frame));
+  if (bytes == NULL || length < CKGF_HEADER_LENGTH ||
+      length > CKGF_MAXIMUM_LENGTH || memcmp(bytes, "CKGF", 4) != 0 ||
+      read_u16(bytes + 4) != 1)
+    return false;
+  frame->kind = bytes[6];
+  frame->flags = bytes[7];
+  frame->base_sequence = read_u64(bytes + 8);
+  frame->output_sequence = read_u64(bytes + 16);
+  frame->rows = read_u32(bytes + 24);
+  frame->columns = read_u32(bytes + 28);
+  uint32_t section_count = read_u32(bytes + 32);
+  if (frame->kind < 1 || frame->kind > 3 || (frame->flags & ~0x01) != 0 ||
+      frame->rows == 0 || frame->columns == 0 ||
+      frame->output_sequence == 0 || section_count > 7)
+    return false;
+  if ((frame->kind == 1 &&
+       (frame->flags != 1 || frame->base_sequence != 0)) ||
+      (frame->kind != 1 && frame->flags != 0) ||
+      (frame->kind == 2 &&
+       frame->base_sequence >= frame->output_sequence))
+    return false;
+
+  bool seen[8] = {false};
+  size_t offset = CKGF_HEADER_LENGTH;
+  for (uint32_t i = 0; i < section_count; ++i) {
+    if (length - offset < 8) return false;
+    uint8_t type = bytes[offset];
+    uint32_t payload_length = read_u32(bytes + offset + 4);
+    if (type < 1 || type > 7 || seen[type] ||
+        !zero3(bytes + offset + 1))
+      return false;
+    seen[type] = true;
+    offset += 8;
+    if (payload_length > length - offset) return false;
+    const uint8_t *payload = bytes + offset;
+    frame->sections[type] = payload;
+    frame->section_lengths[type] = payload_length;
+    bool valid = false;
+    switch (type) {
+      case 1:
+        valid = validate_palette(frame, payload, payload_length);
+        break;
+      case 2:
+        valid = validate_cursor(payload, payload_length, frame->rows,
+                                frame->columns);
+        break;
+      case 3:
+        valid = validate_rows(frame, payload, payload_length);
+        break;
+      case 4:
+        valid = validate_cells(frame, payload, payload_length);
+        break;
+      case 5:
+        valid = validate_graphemes(frame, payload, payload_length);
+        break;
+      case 6:
+        valid = validate_styles(frame, payload, payload_length);
+        break;
+      case 7:
+        valid = validate_scrollback(payload, payload_length);
+        break;
+    }
+    if (!valid) return false;
+    offset += payload_length;
+  }
+  if (offset != length) return false;
+  if (frame->kind == 1) {
+    if (frame->palette_count != 256 ||
+        !(seen[1] && seen[2] && seen[3] && seen[4] && seen[5] &&
+          seen[6]) || seen[7])
+      return false;
+  } else if (frame->kind == 2) {
+    if (seen[1] || !(seen[2] && seen[3] && seen[4] && seen[5] &&
+                     seen[6]) || seen[7])
+      return false;
+  } else if (section_count != 1 || !seen[7]) {
+    return false;
+  }
+  return frame->kind == 3 || validate_cross_references(frame);
+}
+
+static const uint8_t *grapheme_at(const cockpit_frame_t *frame,
+                                  uint32_t wanted, uint32_t *length) {
+  if (wanted == 0) {
+    *length = 0;
+    return NULL;
+  }
+  const uint8_t *payload = frame->sections[5];
+  size_t offset = 4;
+  for (uint32_t index = 1; index <= frame->grapheme_count; ++index) {
+    uint32_t byte_length = read_u32(payload + offset + 4);
+    offset += 8;
+    if (index == wanted) {
+      *length = byte_length;
+      return payload + offset;
+    }
+    offset += byte_length;
+  }
+  return NULL;
+}
+
+static void style_at(const cockpit_frame_t *frame, uint32_t wanted,
+                     cockpit_render_cell_t *cell) {
+  if (wanted == 0) return;
+  const uint8_t *entry = frame->sections[6] + 4 +
+                         (size_t)(wanted - 1) * 16;
+  cell->foreground_kind = entry[4];
+  cell->background_kind = entry[5];
+  cell->flags = entry[6];
+  cell->underline = entry[7];
+  cell->foreground = read_u32(entry + 8);
+  cell->background = read_u32(entry + 12);
+}
+
+static void free_cells(cockpit_render_cell_t *cells, size_t count) {
+  if (cells == NULL) return;
+  for (size_t i = 0; i < count; ++i) free(cells[i].text);
+  free(cells);
+}
+
+static bool build_frame_cells(const cockpit_frame_t *frame,
+                              cockpit_render_cell_t **result) {
+  *result = NULL;
+  if (frame->cell_count == 0) return true;
+  cockpit_render_cell_t *cells = calloc(frame->cell_count, sizeof(*cells));
+  if (cells == NULL) return false;
+  const uint8_t *payload = frame->sections[4];
+  for (uint32_t i = 0; i < frame->cell_count; ++i) {
+    const uint8_t *entry = payload + 4 + (size_t)i * 20;
+    cockpit_render_cell_t *cell = &cells[i];
+    cell->row = read_u32(entry);
+    cell->column = read_u32(entry + 4);
+    cell->width = entry[8];
+    uint32_t grapheme = read_u32(entry + 12);
+    uint32_t style = read_u32(entry + 16);
+    const uint8_t *text = grapheme_at(frame, grapheme, &cell->text_length);
+    if (cell->text_length > 0) {
+      cell->text = malloc((size_t)cell->text_length + 1);
+      if (cell->text == NULL) {
+        free_cells(cells, frame->cell_count);
+        return false;
+      }
+      memcpy(cell->text, text, cell->text_length);
+      cell->text[cell->text_length] = 0;
+    }
+    style_at(frame, style, cell);
+  }
+  *result = cells;
+  return true;
+}
+
+static bool dirty_row(const cockpit_frame_t *frame, uint32_t row) {
+  const uint8_t *rows = frame->sections[3];
+  uint32_t low = 0;
+  uint32_t high = frame->row_count;
+  while (low < high) {
+    uint32_t middle = low + (high - low) / 2;
+    uint32_t candidate = read_u32(rows + 4 + (size_t)middle * 16);
+    if (candidate < row)
+      low = middle + 1;
+    else
+      high = middle;
+  }
+  return low < frame->row_count &&
+         read_u32(rows + 4 + (size_t)low * 16) == row;
+}
+
+static int compare_cells(const void *left_pointer, const void *right_pointer) {
+  const cockpit_render_cell_t *left = left_pointer;
+  const cockpit_render_cell_t *right = right_pointer;
+  if (left->row != right->row) return left->row < right->row ? -1 : 1;
+  if (left->column != right->column)
+    return left->column < right->column ? -1 : 1;
+  return 0;
+}
+
+static bool apply_snapshot(cockpit_ghostty_renderer_t *renderer,
+                           const cockpit_frame_t *frame) {
+  cockpit_render_cell_t *cells = NULL;
+  if (!build_frame_cells(frame, &cells)) return false;
+  free_cells(renderer->cells, renderer->cell_count);
+  renderer->cells = cells;
+  renderer->cell_count = frame->cell_count;
+  renderer->rows = frame->rows;
+  renderer->columns = frame->columns;
+  initialize_palette(renderer->palette);
+  const uint8_t *palette = frame->sections[1];
+  for (uint32_t i = 0; i < frame->palette_count; ++i) {
+    const uint8_t *entry = palette + 4 + (size_t)i * 6;
+    uint16_t index = read_u16(entry);
+    renderer->palette[index] =
+        (cockpit_rgb_t){entry[2], entry[3], entry[4]};
+  }
+  const uint8_t *cursor = frame->sections[2];
+  renderer->cursor_row = read_u32(cursor);
+  renderer->cursor_column = read_u32(cursor + 4);
+  renderer->cursor_shape = cursor[8];
+  renderer->cursor_visible = cursor[9] != 0;
+  renderer->cursor_blinking = cursor[10] != 0;
+  renderer->sequence = frame->output_sequence;
+  renderer->has_viewport = true;
+  return true;
+}
+
+static bool apply_delta(cockpit_ghostty_renderer_t *renderer,
+                        const cockpit_frame_t *frame) {
+  cockpit_render_cell_t *delta_cells = NULL;
+  if (!build_frame_cells(frame, &delta_cells)) return false;
+  size_t retained = 0;
+  for (size_t i = 0; i < renderer->cell_count; ++i) {
+    if (!dirty_row(frame, renderer->cells[i].row)) ++retained;
+  }
+  if (retained > SIZE_MAX - frame->cell_count) {
+    free_cells(delta_cells, frame->cell_count);
+    return false;
+  }
+  size_t combined_count = retained + frame->cell_count;
+  cockpit_render_cell_t *combined =
+      combined_count == 0 ? NULL : calloc(combined_count, sizeof(*combined));
+  if (combined_count > 0 && combined == NULL) {
+    free_cells(delta_cells, frame->cell_count);
+    return false;
+  }
+  size_t output = 0;
+  for (size_t i = 0; i < renderer->cell_count; ++i) {
+    if (dirty_row(frame, renderer->cells[i].row)) {
+      free(renderer->cells[i].text);
+    } else {
+      combined[output++] = renderer->cells[i];
+    }
+  }
+  for (uint32_t i = 0; i < frame->cell_count; ++i)
+    combined[output++] = delta_cells[i];
+  free(delta_cells);
+  free(renderer->cells);
+  renderer->cells = combined;
+  renderer->cell_count = combined_count;
+  if (combined_count > 1)
+    qsort(combined, combined_count, sizeof(*combined), compare_cells);
+  const uint8_t *cursor = frame->sections[2];
+  renderer->cursor_row = read_u32(cursor);
+  renderer->cursor_column = read_u32(cursor + 4);
+  renderer->cursor_shape = cursor[8];
+  renderer->cursor_visible = cursor[9] != 0;
+  renderer->cursor_blinking = cursor[10] != 0;
+  renderer->sequence = frame->output_sequence;
+  return true;
+}
+
+static bool clone_render_state(const cockpit_ghostty_renderer_t *source,
+                               cockpit_ghostty_renderer_t *destination) {
+  destination->view = source->view;
+  destination->layer = source->layer;
+  destination->device = source->device;
+  destination->command_queue = source->command_queue;
+  // A failed staged draw must not overwrite textures owned by the committed
+  // renderer. Fresh textures are published only by commit_render_state.
+  destination->upload_texture = nil;
+  destination->offscreen_texture = nil;
+  memcpy(destination->palette, source->palette, sizeof(source->palette));
+  destination->rows = source->rows;
+  destination->columns = source->columns;
+  destination->cursor_row = source->cursor_row;
+  destination->cursor_column = source->cursor_column;
+  destination->cursor_shape = source->cursor_shape;
+  destination->cursor_visible = source->cursor_visible;
+  destination->cursor_blinking = source->cursor_blinking;
+  destination->sequence = source->sequence;
+  destination->pixels_w = source->pixels_w;
+  destination->pixels_h = source->pixels_h;
+  destination->scale = source->scale;
+  destination->has_viewport = source->has_viewport;
+  destination->visible = source->visible;
+
+  if (source->cell_count == 0) return true;
+  destination->cells = calloc(source->cell_count, sizeof(*destination->cells));
+  if (destination->cells == NULL) return false;
+  destination->cell_count = source->cell_count;
+  for (size_t index = 0; index < source->cell_count; ++index) {
+    destination->cells[index] = source->cells[index];
+    destination->cells[index].text = NULL;
+    if (source->cells[index].text_length == 0) continue;
+    destination->cells[index].text =
+        malloc(source->cells[index].text_length);
+    if (destination->cells[index].text == NULL) {
+      free_cells(destination->cells, destination->cell_count);
+      destination->cells = NULL;
+      destination->cell_count = 0;
+      return false;
+    }
+    memcpy(destination->cells[index].text, source->cells[index].text,
+           source->cells[index].text_length);
+  }
+  return true;
+}
+
+static void commit_render_state(cockpit_ghostty_renderer_t *destination,
+                                cockpit_ghostty_renderer_t *source) {
+  free_cells(destination->cells, destination->cell_count);
+  destination->cells = source->cells;
+  destination->cell_count = source->cell_count;
+  source->cells = NULL;
+  source->cell_count = 0;
+  memcpy(destination->palette, source->palette, sizeof(source->palette));
+  destination->rows = source->rows;
+  destination->columns = source->columns;
+  destination->cursor_row = source->cursor_row;
+  destination->cursor_column = source->cursor_column;
+  destination->cursor_shape = source->cursor_shape;
+  destination->cursor_visible = source->cursor_visible;
+  destination->cursor_blinking = source->cursor_blinking;
+  destination->sequence = source->sequence;
+  destination->upload_texture = source->upload_texture;
+  destination->offscreen_texture = source->offscreen_texture;
+  destination->has_viewport = source->has_viewport;
+}
+
+static void initialize_palette(cockpit_rgb_t *palette) {
+  static const cockpit_rgb_t ansi[16] = {
+      {0, 0, 0},       {205, 49, 49},   {13, 188, 121}, {229, 229, 16},
+      {36, 114, 200},  {188, 63, 188},  {17, 168, 205}, {229, 229, 229},
+      {102, 102, 102}, {241, 76, 76},   {35, 209, 139}, {245, 245, 67},
+      {59, 142, 234},  {214, 112, 214}, {41, 184, 219}, {255, 255, 255},
+  };
+  memcpy(palette, ansi, sizeof(ansi));
+  static const uint8_t cube[] = {0, 95, 135, 175, 215, 255};
+  for (uint32_t index = 16; index < 232; ++index) {
+    uint32_t value = index - 16;
+    palette[index] = (cockpit_rgb_t){cube[value / 36],
+                                     cube[(value / 6) % 6], cube[value % 6]};
+  }
+  for (uint32_t index = 232; index < 256; ++index) {
+    uint8_t value = (uint8_t)(8 + (index - 232) * 10);
+    palette[index] = (cockpit_rgb_t){value, value, value};
+  }
+}
+
+static cockpit_rgb_t color_for(cockpit_ghostty_renderer_t *renderer,
+                               uint8_t kind, uint32_t value,
+                               cockpit_rgb_t fallback) {
+  if (kind == 1) return renderer->palette[value];
+  if (kind == 2)
+    return (cockpit_rgb_t){(uint8_t)(value >> 16), (uint8_t)(value >> 8),
+                           (uint8_t)value};
+  return fallback;
+}
+
+static NSColor *ns_color(cockpit_rgb_t value, CGFloat alpha) {
+  return [NSColor colorWithSRGBRed:(CGFloat)value.red / 255.0
+                             green:(CGFloat)value.green / 255.0
+                              blue:(CGFloat)value.blue / 255.0
+                             alpha:alpha];
+}
+
+static bool texture_dimensions_match(id<MTLTexture> texture, NSUInteger width,
+                                     NSUInteger height) {
+  return texture != nil && texture.width == width && texture.height == height;
+}
+
+static bool ensure_textures(cockpit_ghostty_renderer_t *renderer,
+                            NSUInteger width, NSUInteger height) {
+  if (texture_dimensions_match(renderer->upload_texture, width, height) &&
+      texture_dimensions_match(renderer->offscreen_texture, width, height))
+    return true;
+  MTLTextureDescriptor *upload = [MTLTextureDescriptor
+      texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                   width:width
+                                  height:height
+                               mipmapped:NO];
+  upload.storageMode = MTLStorageModeShared;
+  upload.usage = MTLTextureUsageShaderRead;
+  MTLTextureDescriptor *offscreen = [upload copy];
+  offscreen.storageMode = MTLStorageModePrivate;
+  offscreen.usage = MTLTextureUsageShaderRead;
+  renderer->upload_texture = [renderer->device newTextureWithDescriptor:upload];
+  renderer->offscreen_texture =
+      [renderer->device newTextureWithDescriptor:offscreen];
+  return renderer->upload_texture != nil && renderer->offscreen_texture != nil;
+}
+
+static bool render_viewport(cockpit_ghostty_renderer_t *renderer) {
+  if (!renderer->has_viewport || renderer->rows == 0 ||
+      renderer->columns == 0)
+    return false;
+  NSUInteger width = renderer->pixels_w;
+  NSUInteger height = renderer->pixels_h;
+  if (width == 0 || height == 0) {
+    NSRect bounds = renderer->view.bounds;
+    width = (NSUInteger)llround(bounds.size.width * renderer->scale);
+    height = (NSUInteger)llround(bounds.size.height * renderer->scale);
+  }
+  if (width == 0 || height == 0 || width > SIZE_MAX / height ||
+      width * height > SIZE_MAX / 4 || !ensure_textures(renderer, width, height))
+    return false;
+
+  size_t bytes_per_row = width * 4;
+  uint8_t *bitmap = calloc(height, bytes_per_row);
+  if (bitmap == NULL) return false;
+  unsigned char *planes[5] = {bitmap, NULL, NULL, NULL, NULL};
+  NSBitmapImageRep *image = [[NSBitmapImageRep alloc]
+      initWithBitmapDataPlanes:planes
+                    pixelsWide:(NSInteger)width
+                    pixelsHigh:(NSInteger)height
+                 bitsPerSample:8
+               samplesPerPixel:4
+                      hasAlpha:YES
+                      isPlanar:NO
+                colorSpaceName:NSDeviceRGBColorSpace
+                   bitmapFormat:NSBitmapFormatAlphaFirst |
+                                NSBitmapFormatThirtyTwoBitLittleEndian
+                    bytesPerRow:(NSInteger)bytes_per_row
+                   bitsPerPixel:32];
+  if (image == nil) {
+    free(bitmap);
+    return false;
+  }
+  NSGraphicsContext *context =
+      [NSGraphicsContext graphicsContextWithBitmapImageRep:image];
+  if (context == nil) {
+    free(bitmap);
+    return false;
+  }
+  [NSGraphicsContext saveGraphicsState];
+  [NSGraphicsContext setCurrentContext:context];
+  [ns_color((cockpit_rgb_t){0, 0, 0}, 1.0) setFill];
+  NSRectFill(NSMakeRect(0, 0, width, height));
+
+  CGFloat cell_width = (CGFloat)width / renderer->columns;
+  CGFloat cell_height = (CGFloat)height / renderer->rows;
+  CGFloat font_size = fmax(1.0, cell_height * 0.72);
+  cockpit_rgb_t default_foreground = {229, 229, 229};
+  cockpit_rgb_t default_background = {0, 0, 0};
+  for (size_t i = 0; i < renderer->cell_count; ++i) {
+    cockpit_render_cell_t *cell = &renderer->cells[i];
+    cockpit_rgb_t foreground = color_for(renderer, cell->foreground_kind,
+                                         cell->foreground,
+                                         default_foreground);
+    cockpit_rgb_t background = color_for(renderer, cell->background_kind,
+                                         cell->background,
+                                         default_background);
+    if ((cell->flags & (1u << 4)) != 0) {
+      cockpit_rgb_t swap = foreground;
+      foreground = background;
+      background = swap;
+    }
+    CGFloat x = cell->column * cell_width;
+    CGFloat y = height - (cell->row + 1) * cell_height;
+    CGFloat rendered_width = fmax(cell_width, cell->width * cell_width);
+    if (cell->background_kind != 0 || (cell->flags & (1u << 4)) != 0) {
+      [ns_color(background, 1.0) setFill];
+      NSRectFill(NSMakeRect(x, y, rendered_width, cell_height));
+    }
+    if (cell->text_length == 0 || (cell->flags & (1u << 5)) != 0) continue;
+    NSString *text = [[NSString alloc] initWithBytes:cell->text
+                                             length:cell->text_length
+                                           encoding:NSUTF8StringEncoding];
+    if (text == nil) continue;
+    NSFontWeight weight = (cell->flags & 1u) != 0 ? NSFontWeightBold
+                                                  : NSFontWeightRegular;
+    NSFont *font = [NSFont monospacedSystemFontOfSize:font_size weight:weight];
+    if ((cell->flags & (1u << 1)) != 0)
+      font = [[NSFontManager sharedFontManager] convertFont:font
+                                                toHaveTrait:NSItalicFontMask];
+    CGFloat alpha = (cell->flags & (1u << 2)) != 0 ? 0.5 : 1.0;
+    NSMutableDictionary<NSAttributedStringKey, id> *attributes =
+        [@{NSFontAttributeName : font,
+           NSForegroundColorAttributeName : ns_color(foreground, alpha)}
+            mutableCopy];
+    if (cell->underline != 0)
+      attributes[NSUnderlineStyleAttributeName] =
+          @(cell->underline == 2 ? NSUnderlineStyleDouble
+                                 : NSUnderlineStyleSingle);
+    if ((cell->flags & (1u << 6)) != 0)
+      attributes[NSStrikethroughStyleAttributeName] = @(NSUnderlineStyleSingle);
+    [text drawInRect:NSMakeRect(x, y, rendered_width, cell_height)
+      withAttributes:attributes];
+    if ((cell->flags & (1u << 7)) != 0) {
+      [ns_color(foreground, alpha) setFill];
+      NSRectFill(NSMakeRect(x, y + cell_height - 1, rendered_width, 1));
+    }
+  }
+
+  if (renderer->cursor_visible) {
+    CGFloat x = renderer->cursor_column * cell_width;
+    CGFloat y = height - (renderer->cursor_row + 1) * cell_height;
+    [ns_color((cockpit_rgb_t){255, 255, 255}, 0.55) setFill];
+    if (renderer->cursor_shape == 1)
+      NSRectFill(NSMakeRect(x, y, cell_width, cell_height));
+    else if (renderer->cursor_shape == 2)
+      NSRectFill(NSMakeRect(x, y, fmax(1, cell_width * 0.12), cell_height));
+    else
+      NSRectFill(NSMakeRect(x, y, cell_width, fmax(1, cell_height * 0.12)));
+  }
+  [context flushGraphics];
+  [NSGraphicsContext restoreGraphicsState];
+
+  MTLRegion region = MTLRegionMake2D(0, 0, width, height);
+  [renderer->upload_texture replaceRegion:region
+                              mipmapLevel:0
+                                withBytes:bitmap
+                              bytesPerRow:bytes_per_row];
+  free(bitmap);
+
+  id<MTLCommandBuffer> command_buffer =
+      [renderer->command_queue commandBuffer];
+  id<MTLBlitCommandEncoder> encoder = [command_buffer blitCommandEncoder];
+  if (command_buffer == nil || encoder == nil) return false;
+  MTLSize size = MTLSizeMake(width, height, 1);
+  MTLOrigin origin = MTLOriginMake(0, 0, 0);
+  [encoder copyFromTexture:renderer->upload_texture
+               sourceSlice:0
+               sourceLevel:0
+              sourceOrigin:origin
+                sourceSize:size
+                 toTexture:renderer->offscreen_texture
+          destinationSlice:0
+          destinationLevel:0
+         destinationOrigin:origin];
+  id<CAMetalDrawable> drawable = [renderer->layer nextDrawable];
+  if (drawable != nil && drawable.texture.width == width &&
+      drawable.texture.height == height) {
+    [encoder copyFromTexture:renderer->offscreen_texture
+                 sourceSlice:0
+                 sourceLevel:0
+                sourceOrigin:origin
+                  sourceSize:size
+                   toTexture:drawable.texture
+            destinationSlice:0
+            destinationLevel:0
+           destinationOrigin:origin];
+  }
+  [encoder endEncoding];
+  if (drawable != nil) [command_buffer presentDrawable:drawable];
+  [command_buffer commit];
+  [command_buffer waitUntilCompleted];
+  if (command_buffer.status == MTLCommandBufferStatusError) return false;
+  [renderer->view setNeedsDisplay:YES];
+  return true;
+}
+
+cockpit_ghostty_renderer_t *cockpit_ghostty_renderer_create(void *ns_view,
+                                                             double scale) {
+  if (ns_view == NULL || !isfinite(scale) || scale <= 0) return NULL;
+  NSView *view = (__bridge NSView *)ns_view;
+  id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+  if (device == nil) return NULL;
+  id<MTLCommandQueue> command_queue = [device newCommandQueue];
+  if (command_queue == nil) return NULL;
+  cockpit_ghostty_renderer_t *renderer = calloc(1, sizeof(*renderer));
+  if (renderer == NULL) return NULL;
+  CAMetalLayer *layer = [CAMetalLayer layer];
+  layer.device = device;
+  layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+  layer.framebufferOnly = NO;
+  layer.contentsScale = scale;
+  layer.frame = view.bounds;
+  layer.drawableSize = CGSizeMake(view.bounds.size.width * scale,
+                                  view.bounds.size.height * scale);
+  renderer->view = view;
+  renderer->layer = layer;
+  renderer->original_layer = view.layer;
+  renderer->original_wants_layer = view.wantsLayer;
+  renderer->device = device;
+  renderer->command_queue = command_queue;
+  renderer->scale = scale;
+  renderer->visible = true;
+  initialize_palette(renderer->palette);
+  view.layer = layer;
+  view.wantsLayer = YES;
+  return renderer;
+}
+
+void cockpit_ghostty_renderer_destroy(cockpit_ghostty_renderer_t *renderer) {
+  if (renderer == NULL) return;
+  if (renderer->view.layer == renderer->layer) {
+    renderer->view.layer = renderer->original_layer;
+    renderer->view.wantsLayer = renderer->original_wants_layer;
+  }
+  free_cells(renderer->cells, renderer->cell_count);
+  renderer->cells = NULL;
+  renderer->upload_texture = nil;
+  renderer->offscreen_texture = nil;
+  renderer->command_queue = nil;
+  renderer->device = nil;
+  renderer->original_layer = nil;
+  renderer->layer = nil;
+  renderer->view = nil;
+  free(renderer);
+}
+
+int cockpit_ghostty_renderer_apply(cockpit_ghostty_renderer_t *renderer,
+                                    const uint8_t *bytes, size_t length) {
+  cockpit_frame_t frame;
+  if (renderer == NULL || !validate_frame(bytes, length, &frame)) return -1;
+  if (!renderer->visible) return 0;
+  if (frame.kind == 3) return 1;
+  if (frame.kind == 2 &&
+      (!renderer->has_viewport || frame.rows != renderer->rows ||
+       frame.columns != renderer->columns ||
+       frame.base_sequence != renderer->sequence))
+    return -1;
+  cockpit_ghostty_renderer_t staged = {0};
+  if (!clone_render_state(renderer, &staged)) return -1;
+  bool applied = frame.kind == 1 ? apply_snapshot(&staged, &frame)
+                                 : apply_delta(&staged, &frame);
+  if (!applied || !render_viewport(&staged)) {
+    free_cells(staged.cells, staged.cell_count);
+    return -1;
+  }
+  commit_render_state(renderer, &staged);
+  return 1;
+}
+
+void cockpit_ghostty_renderer_resize(cockpit_ghostty_renderer_t *renderer,
+                                     uint32_t pixels_w, uint32_t pixels_h,
+                                     double scale) {
+  if (renderer == NULL || !isfinite(scale) || scale <= 0) return;
+  renderer->pixels_w = pixels_w;
+  renderer->pixels_h = pixels_h;
+  renderer->scale = scale;
+  renderer->layer.contentsScale = scale;
+  renderer->layer.drawableSize = CGSizeMake(pixels_w, pixels_h);
+  renderer->upload_texture = nil;
+  renderer->offscreen_texture = nil;
+}
+
+void cockpit_ghostty_renderer_set_visible(cockpit_ghostty_renderer_t *renderer,
+                                          bool visible) {
+  if (renderer == NULL) return;
+  renderer->visible = visible;
+  renderer->layer.hidden = !visible;
+}
